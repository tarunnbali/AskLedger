# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string the APP connects with at runtime: the restricted
# askledger_app role. `python -m scripts.setup_database --rotate-password`
# creates it and prints this URL. Never use the owner role here: on Neon (and
# other managed providers) it has BYPASSRLS, which disables tenant isolation.
DATABASE_URL=

# Admin/owner connection string, only for scripts/setup_database.py and
# scripts/seed_data.py. Never used by the running app.
ADMIN_DATABASE_URL=

# Get a free key from https://aistudio.google.com/apikey — used for all LLM
# calls (SQL generation, intent classification, result explanations) via
# Gemini's OpenAI-compatible endpoint. Free tier, no billing setup needed.
GEMINI_API_KEY=
# Models in fallback order (comma-separated), and the SQL prompt version:
# GEMINI_SQL_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.6-flash
# SQL_PROMPT_VERSION=v1

# Any long random string — used to sign login tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call this API.
# Include both your local dev URL and your deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Optional (defaults shown)
# MAX_SQL_ROWS=100
# JWT_EXPIRE_MINUTES=60
# CHAT_RATE_LIMIT=20/hour
