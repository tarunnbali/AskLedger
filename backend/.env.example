# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string the APP connects with at runtime.
# Must be a role WITHOUT the BYPASSRLS attribute, or Row-Level Security
# tenant isolation silently does nothing. See setup_db_role.py — on Neon
# (and some other managed providers) the default owner role has BYPASSRLS,
# so run that script once to create a safe restricted role, then paste its
# output here.
DATABASE_URL=

# Admin/owner connection string — only used by create_tables.py, rls_setup.sql
# (or setup_db_role.py), and seed_data.py. Never used by the running app.
ADMIN_DATABASE_URL=

# Get a key from https://openrouter.ai — used for all LLM calls
# (SQL generation, intent classification, result explanations)
OPENROUTER_API_KEY=

# Any long random string — used to sign login tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call this API.
# Include both your local dev URL and your deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Optional (defaults shown)
# MAX_SQL_ROWS=100
# JWT_EXPIRE_MINUTES=60
# CHAT_RATE_LIMIT=20/hour
